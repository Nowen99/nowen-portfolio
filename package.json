{
  "name": "nowen-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static professional engineering portfolio with local live reload.",
  "scripts": {
    "dev": "browser-sync start --server . --files \"**/*.html,**/*.css,**/*.js\" --ignore \"node_modules\" --listen localhost --host localhost --port 3000 --no-open --no-ui --no-online --no-notify --no-ghost-mode"
  },
  "devDependencies": {
    "browser-sync": "3.0.4"
  }
}
